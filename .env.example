# ── Supabase ──────────────────────────────────────────────────────────────────
# URL de base de votre projet Supabase (sans slash final)
# Format : https://VOTRE_ID.supabase.co/rest/v1
SUPABASE_URL=https://VOTRE_ID.supabase.co/rest/v1

# Clé service (Settings > API > service_role key)
SUPABASE_KEY=votre_cle_service_supabase

# ── Anthropic ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=votre_cle_anthropic
ANTHROPIC_USD_TO_EUR_RATE=0.86088154
AI_USAGE_PRICING_VERSION=anthropic-usd-eur-2026-09-11-v1
# Optional versioned EUR rates per million tokens. Keep them aligned with
# AI_USAGE_PRICING_VERSION whenever pricing or the FX snapshot changes.
CLAUDE_SONNET_4_6_INPUT_EUR_PER_MTOKEN=2.58264463
CLAUDE_SONNET_4_6_OUTPUT_EUR_PER_MTOKEN=12.91322314
CLAUDE_SONNET_4_6_CACHE_CREATION_INPUT_EUR_PER_MTOKEN=3.22830579
CLAUDE_SONNET_4_6_CACHE_READ_INPUT_EUR_PER_MTOKEN=0.25826446
CLAUDE_OPUS_4_7_INPUT_EUR_PER_MTOKEN=4.30440771
CLAUDE_OPUS_4_7_OUTPUT_EUR_PER_MTOKEN=21.52203857
CLAUDE_OPUS_4_7_CACHE_CREATION_INPUT_EUR_PER_MTOKEN=5.38050964
CLAUDE_OPUS_4_7_CACHE_READ_INPUT_EUR_PER_MTOKEN=0.43044077

# ── Sécurité ──────────────────────────────────────────────────────────────────
# Générer avec : openssl rand -hex 32
WEBHOOK_SECRET=votre_secret_webhook
DASHBOARD_SECRET=votre_secret_dashboard
CORS_ALLOWED_ORIGINS=https://votre-dashboard.vercel.app
ENVIRONMENT=production
ALLOWED_USER_IDS=
EXPOSE_API_DOCS=false
AI_REQUEST_SLOT_SECONDS=60
WEBHOOK_REPLAY_WINDOW_SECONDS=600
MAX_PDF_PAGES=40
MAX_EXTRACTED_TEXT_CHARS=120000
MAX_DOCX_XML_BYTES=5000000

# ── ManyChat ──────────────────────────────────────────────────────────────────
MANYCHAT_TOKEN=votre_token_manychat

# ── WhatsApp Cloud API ────────────────────────────────────────────────────────
WHATSAPP_ACCESS_TOKEN=votre_token_whatsapp_cloud_api
WHATSAPP_PHONE_NUMBER_ID=votre_phone_number_id
WHATSAPP_VERIFY_TOKEN=votre_secret_verify_token
META_APP_SECRET=votre_meta_app_secret
GRAPH_API_VERSION=v23.0

# ── Identité du coach ─────────────────────────────────────────────────────────
BUSINESS_NAME=Nom de votre business
COACH_NAME=Prénom Nom du coach
AGENT_NAME=Nom de votre agent IA

# ── URLs métier ───────────────────────────────────────────────────────────────
URL_PAGE=https://votre-page-de-vente.com
URL_CALL=https://calendly.com/votre-lien
CONTACT_EMAIL=votre@email.com

# ── Contexte métier (avatar client, positionnement, sources ManyChat) ─────────
# Ce texte est injecté tel quel dans le system prompt de l'agent.
# Il définit à qui vous parlez et comment vous vous positionnez.
# Peut être sur plusieurs lignes dans Railway (éditeur de variables).
# Exemple :
#
# POSITIONNEMENT :
# - Approche scientifique, long terme
# - Expert coach, pas vendeur
# - Style WhatsApp : court, chaleureux, direct
#
# AVATAR CLIENT : [Décrivez votre client idéal — profil, problèmes, frustrations]
#
# SOURCES D'ENTRÉE :
# - "Analyse" → script qualification en 5 étapes
# - Nouveau follower → script d'accueil
# - [Autres automations ManyChat de votre setup]
NICHE_CONTEXT=
