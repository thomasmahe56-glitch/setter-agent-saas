# ── Supabase ──────────────────────────────────────────────────────────────────
# URL de base de votre projet Supabase (sans slash final)
# Format : https://VOTRE_ID.supabase.co/rest/v1
SUPABASE_URL=https://VOTRE_ID.supabase.co/rest/v1

# Clé service (Settings > API > service_role key)
SUPABASE_KEY=votre_cle_service_supabase

# ── Anthropic ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=votre_cle_anthropic
ANTHROPIC_USD_TO_EUR_RATE=0.86088154
AI_USAGE_PRICING_VERSION=multi-provider-usd-eur-2026-09-12-v1
# Optional versioned EUR rates per million tokens. Keep them aligned with
# AI_USAGE_PRICING_VERSION whenever pricing or the FX snapshot changes.
CLAUDE_SONNET_4_6_INPUT_EUR_PER_MTOKEN=2.58264463
CLAUDE_SONNET_4_6_OUTPUT_EUR_PER_MTOKEN=12.91322314
CLAUDE_SONNET_4_6_CACHE_CREATION_INPUT_EUR_PER_MTOKEN=3.22830579
CLAUDE_SONNET_4_6_CACHE_READ_INPUT_EUR_PER_MTOKEN=0.25826446
CLAUDE_OPUS_4_7_INPUT_EUR_PER_MTOKEN=4.30440771
CLAUDE_OPUS_4_7_OUTPUT_EUR_PER_MTOKEN=21.52203857
CLAUDE_OPUS_4_7_CACHE_CREATION_INPUT_EUR_PER_MTOKEN=5.38050964
CLAUDE_OPUS_4_7_CACHE_READ_INPUT_EUR_PER_MTOKEN=0.43044077

# ── OpenAI + routage Setter ───────────────────────────────────────────────────
OPENAI_API_KEY=votre_cle_openai
SETTER_PRIMARY_PROVIDER=openai
SETTER_PRIMARY_MODEL=gpt-5.6-luna
SETTER_PREMIUM_PROVIDER=anthropic
SETTER_PREMIUM_MODEL=claude-sonnet-4-6
SETTER_OPENAI_ENABLED=true
SETTER_CONTEXT_COMPRESSION_ENABLED=true
SETTER_PERSISTENT_IDEMPOTENCY_ENABLED=true
SETTER_PREMIUM_ESCALATION_ENABLED=false
OPENAI_USD_TO_EUR_RATE=0.86088154
GPT_5_6_LUNA_INPUT_EUR_PER_MTOKEN=0.17217631
GPT_5_6_LUNA_OUTPUT_EUR_PER_MTOKEN=1.03305785
GPT_5_6_LUNA_CACHE_CREATION_INPUT_EUR_PER_MTOKEN=0.21522039
GPT_5_6_LUNA_CACHED_INPUT_EUR_PER_MTOKEN=0.01721763

# Fenêtre/mémoire conversationnelle et plafonds par opération
SETTER_RECENT_MESSAGES=10
SETTER_MEMORY_THRESHOLD_MESSAGES=24
SETTER_MEMORY_REFRESH_MESSAGES=12
SETTER_REPLY_MAX_OUTPUT_TOKENS=384
SETTER_FOLLOW_UP_MAX_OUTPUT_TOKENS=256
SETTER_SUPERVISED_MAX_OUTPUT_TOKENS=384
SETTER_REFINE_MAX_OUTPUT_TOKENS=384
SETTER_SUMMARY_MAX_OUTPUT_TOKENS=512
SETTER_SIMULATOR_MAX_OUTPUT_TOKENS=500
SETTER_PLAYGROUND_MAX_OUTPUT_TOKENS=500

# ── Sécurité ──────────────────────────────────────────────────────────────────
# Générer avec : openssl rand -hex 32
WEBHOOK_SECRET=votre_secret_webhook
DASHBOARD_SECRET=votre_secret_dashboard
CORS_ALLOWED_ORIGINS=https://votre-dashboard.vercel.app
ENVIRONMENT=production
ALLOWED_USER_IDS=
EXPOSE_API_DOCS=false
AI_REQUEST_SLOT_SECONDS=60
WEBHOOK_REPLAY_WINDOW_SECONDS=600
MAX_PDF_PAGES=40
MAX_EXTRACTED_TEXT_CHARS=120000
MAX_DOCX_XML_BYTES=5000000

# ── ManyChat ──────────────────────────────────────────────────────────────────
MANYCHAT_TOKEN=votre_token_manychat

# ── Instagram API with Instagram Login (Meta Native, disabled by default) ─────
META_APP_ID=votre_meta_app_id
META_APP_SECRET=votre_meta_app_secret
META_WEBHOOK_VERIFY_TOKEN=votre_secret_verify_token_instagram
META_INSTAGRAM_REDIRECT_URI=https://votre-backend.up.railway.app/oauth/meta/instagram/callback
META_INSTAGRAM_POST_CONNECT_URL=https://votre-dashboard.vercel.app/settings/integrations
# Current Graph API version verified at implementation time; review before upgrades.
META_GRAPH_API_VERSION=v26.0
# Generate with: openssl rand -base64 32 | tr '+/' '-_' | tr -d '\n'
MESSAGING_TOKEN_ENCRYPTION_KEY=
META_INSTAGRAM_ENABLED=false
META_INSTAGRAM_OAUTH_ENABLED=false
META_INSTAGRAM_WEBHOOK_ENABLED=false
META_INSTAGRAM_SEND_ENABLED=false
META_INSTAGRAM_HISTORY_SYNC_ENABLED=false
# Standard reply window; re-verify against Meta policy before changing.
META_INSTAGRAM_REPLY_WINDOW_HOURS=24

# ── WhatsApp Cloud API ────────────────────────────────────────────────────────
WHATSAPP_ACCESS_TOKEN=votre_token_whatsapp_cloud_api
WHATSAPP_PHONE_NUMBER_ID=votre_phone_number_id
WHATSAPP_VERIFY_TOKEN=votre_secret_verify_token
GRAPH_API_VERSION=v23.0

# ── Identité du coach ─────────────────────────────────────────────────────────
BUSINESS_NAME=Nom de votre business
COACH_NAME=Prénom Nom du coach
AGENT_NAME=Nom de votre agent IA

# ── URLs métier ───────────────────────────────────────────────────────────────
URL_PAGE=https://votre-page-de-vente.com
URL_CALL=https://calendly.com/votre-lien
CONTACT_EMAIL=votre@email.com

# ── Contexte métier (avatar client, positionnement, sources ManyChat) ─────────
# Ce texte est injecté tel quel dans le system prompt de l'agent.
# Il définit à qui vous parlez et comment vous vous positionnez.
# Peut être sur plusieurs lignes dans Railway (éditeur de variables).
# Exemple :
#
# POSITIONNEMENT :
# - Approche scientifique, long terme
# - Expert coach, pas vendeur
# - Style WhatsApp : court, chaleureux, direct
#
# AVATAR CLIENT : [Décrivez votre client idéal — profil, problèmes, frustrations]
#
# SOURCES D'ENTRÉE :
# - "Analyse" → script qualification en 5 étapes
# - Nouveau follower → script d'accueil
# - [Autres automations ManyChat de votre setup]
NICHE_CONTEXT=
